    "content": "python tools/build_content.py",
    "audio": "python tools/gen_audio.py"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
