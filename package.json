{
  "name": "cn-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 2D learning RPG for 美洲華語 第一冊, for first graders at a Sunday Chinese school.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
